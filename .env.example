# Settings for docker compose. Copy to .env (it stays out of git) and set a real password.
# The password becomes part of a database URL: use only letters, digits, "-" and "_".
POSTGRES_USER=brain_mri
POSTGRES_PASSWORD=change-me
POSTGRES_DB=brain_mri

# Ports on this machine; both are bound to 127.0.0.1 only.
# 5433 avoids a clash with a locally installed Postgres on 5432.
POSTGRES_PORT=5433
API_PORT=8000

# Passed to the backend (see backend/.env.example for their meaning).
DEVICE=cpu
MAX_UPLOAD_MB=10
MAX_PIXELS=16777216
