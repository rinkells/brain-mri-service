# Settings for docker compose. Copy to .env (it stays out of git) and set a real password.
# The password becomes part of a database URL: use only letters, digits, "-" and "_".
POSTGRES_USER=brain_mri
POSTGRES_PASSWORD=change-me
POSTGRES_DB=brain_mri

# Ports on this machine; both are bound to 127.0.0.1 only.
# 5433 avoids a clash with a locally installed Postgres on 5432.
POSTGRES_PORT=5433
API_PORT=8000

# Passed to the backend (see backend/.env.example for their meaning).
DEVICE=cpu
# nginx does not read this: above 10, also raise client_max_body_size in
# frontend/nginx.conf (1-5 MB more) and rebuild frontend.
MAX_UPLOAD_MB=10
MAX_PIXELS=16777216
MAX_IMAGE_SIDE=4096
MAX_CONCURRENT_INFERENCES=2
MAX_QUEUE=20
LOW_CONFIDENCE_THRESHOLD=0.9
NOT_MRI_COLOR_MAX=7
NOT_MRI_NOISE_MAX=0.85
NOT_MRI_STD_MIN=10
NOT_MRI_LOWCONTRAST_STD=30
NOT_MRI_DARK_MIN=0.15
NOT_MRI_OPAQUE_MIN=0.99
# Leave unset for the defaults; the API origins then follow API_PORT.
# ALLOWED_HOSTS=localhost,127.0.0.1,api
ENABLE_DOCS=true
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080

# Requests per client in any 60 s (see backend/.env.example); /health and /health/ready
# are never limited.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PREDICT_PER_MINUTE=10
RATE_LIMIT_WRITE_PER_MINUTE=30
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10

# Accounts and sessions (see backend/.env.example). Keep SESSION_COOKIE_SECURE=false while
# the interface is served over plain HTTP on localhost.
SESSION_TTL_HOURS=168
SESSION_COOKIE_NAME=brain_mri_session
SESSION_COOKIE_SECURE=false
SESSION_MAX_PER_USER=10
LOGIN_FAILURES_MAX=5
LOGIN_FAILURES_WINDOW_MINUTES=15
