# Copy to .env and adjust. Real values stay out of git (.env is in .gitignore).
MODEL_PATH=models/resnet18_v2c_best.pt
# Name of the weights above; returned by the API and saved in history. Change it with MODEL_PATH.
MODEL_VERSION=resnet18_v2c
DEVICE=cpu
MAX_UPLOAD_MB=10
MAX_PIXELS=16777216
# Longest allowed side of a scan in pixels; larger scans are refused with 413.
MAX_IMAGE_SIDE=4096
# Predictions that run at the same time; up to MAX_QUEUE more wait, the rest get 503.
MAX_CONCURRENT_INFERENCES=2
MAX_QUEUE=20
# Predictions with a top-1 probability below this get a low_confidence warning (0 to 1).
LOW_CONFIDENCE_THRESHOLD=0.9

# Host headers the API answers to (comma-separated); others get 400. "*" allows any.
ALLOWED_HOSTS=localhost,127.0.0.1,api
# Origins whose pages may send POST and DELETE (comma-separated); others get 403.
# Requests without an Origin header (curl, scripts) are not affected.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8000,http://127.0.0.1:8000

# Prediction history. Leave unset to run without a database (no history).
# Matches the Postgres started by `docker compose up -d db` with the root .env.example values.
# DATABASE_URL=postgresql+psycopg://brain_mri:change-me@127.0.0.1:5433/brain_mri

# Swagger UI (/docs), ReDoc (/redoc) and /openapi.json; set to false to remove them.
ENABLE_DOCS=true
