# Copy to .env and adjust. Real values stay out of git (.env is in .gitignore).
MODEL_PATH=models/resnet18_v2_best.pt
DEVICE=cpu
MAX_UPLOAD_MB=10
MAX_PIXELS=16777216

# Prediction history. Leave unset to run without a database (no history).
# Matches the Postgres started by `docker compose up -d db` with the root .env.example values.
# DATABASE_URL=postgresql+psycopg://brain_mri:change-me@127.0.0.1:5433/brain_mri
